# Frontend app configuration
# Copy this file to `.env` and replace the placeholder values.

# Privy React SDK app ID from the Privy dashboard.
VITE_PRIVY_APP_ID=your_privy_app_id

# Public Supabase project URL + anon key used by the frontend
# to call the `chat-grok` edge function over HTTPS.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ElevenLabs conversational agent ID used by the voice widget.
VITE_ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id

# Optional overrides for demo flows.
VITE_MOONPAY_URL=https://buy.moonpay.com
VITE_PAYSH_URL=https://pay.sh
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_SOLANA_NETWORK_LABEL=Devnet

# Supabase edge function secrets are configured separately and should
# never be added to the frontend `.env` file:
# GROK_API_KEY=your_xai_api_key
# XAI_MODEL=grok-3-mini-fast
